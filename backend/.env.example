POSTGRES_USER=clips_user
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=clips_generator
DATABASE_URL=postgresql://clips_user:replace-with-a-local-password@localhost:5433/clips_generator
REDIS_URL=redis://localhost:6379/0
OPENAI_API_KEY=replace-with-your-openai-api-key

# Déjalas vacías si ambos ejecutables están disponibles en PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# Opcional durante el desarrollo local; configura las cuatro juntas para usar R2.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_BUCKET_NAME=your-private-bucket
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
